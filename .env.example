# Copy to .env and adjust. Never commit the real .env.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- LLM voice layer (personas / advisors / written-defense grade) ---
# provider: anthropic | openai | offline   (offline needs no key and no network)
# Defaults to Anthropic's cheapest model, Claude Haiku 4.5 ($1/$5 per MTok).
# Set ANTHROPIC_API_KEY to actually use it; without a key the app safely
# falls back to the deterministic offline client so it still runs.
FLEXEE_LLM_PROVIDER=anthropic
FLEXEE_LLM_MODEL=claude-haiku-4-5
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Email (student invite delivery) ---
# MAIL_BACKEND: mailjet | smtp | (unset -> console backend, logs instead of sending)
# FRONTEND_URL is the base for the join links students receive.
FRONTEND_URL=http://localhost:3000
# MAIL_BACKEND=mailjet
# MAILJET_API_KEY=
# MAILJET_API_SECRET=
# MAIL_FROM_ADDRESS=no-reply@yourdomain.org
# MAIL_FROM_NAME=Flexee
# For SMTP instead of Mailjet: MAIL_BACKEND=smtp plus EMAIL_HOST / EMAIL_PORT /
# EMAIL_HOST_USER / EMAIL_HOST_PASSWORD / EMAIL_USE_TLS

# --- Postgres (leave POSTGRES_DB unset to use SQLite for local dev) ---
# POSTGRES_DB=flexee
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_CONN_MAX_AGE=60

# --- Deployment: addresses ---
# The API's public address with no path (the reporting connector's discovery documents name it).
# PUBLIC_API_URL=https://api.example.org

# --- Round scheduler and reminders ---
# Closes due rounds and sends the day-before reminder. Run `python manage.py run_scheduler`, or call
# GET/POST /meridian/api/cron/round-tick/ with "Authorization: Bearer $CRON_SECRET" from a cron.
# Without either, deadlines are still enforced lazily when someone opens a page.
# CRON_SECRET=
# REMINDER_EMAILS_ENABLED=true
# EMAIL_DRY_RUN=false

# --- Ask Claude and AI spending ---
# FLEXEE_ASK_MODEL=claude-sonnet-5-5
# FLEXEE_ASK_QUESTIONS_PER_MONTH=100
# One ceiling for every AI feature on the site, US dollars per UTC calendar month.
# FLEXEE_AI_MONTHLY_CEILING_USD=50
# Override list prices (US dollars per million tokens) if a model is not in the built-in table.
# FLEXEE_LLM_INPUT_USD_PER_MTOK=
# FLEXEE_LLM_OUTPUT_USD_PER_MTOK=

# --- Reporting ---
# The deployed commit, reported by the reporting connector's report_health.
# GIT_COMMIT=
